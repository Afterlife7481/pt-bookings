# Deployment tier: local | staging | production.
# Controls per-environment behaviour (e.g. only "local" shows magic links in the UI).
# Staging also disables API rate limits for easier QA.
# Leave unset locally (inferred from `next dev`); set explicitly on each server.
APP_ENV=local

DATABASE_URL=postgresql://user:password@host:port/database
# Isolated Postgres for npm test / e2e only — never wipe or seed DATABASE_URL (dev data)
TEST_DATABASE_URL=postgresql://user:password@host:port/database_test
# Public URL for magic links, WhatsApp messages, and client session links.
# Read at runtime on the server; on Railway/Vercel the platform domain is used
# as a fallback when unset.
APP_BASE_URL=http://localhost:3000
# Email delivery (Resend) — required in production for magic-link sign-in.
# Without RESEND_API_KEY, links are printed to the server console (local dev only).
RESEND_API_KEY=
# Verified sender. Must be on a domain you've verified in Resend.
EMAIL_FROM="PT Bookings <noreply@example.com>"
# Local tier only: set to 0 to hide magic links in the UI/response.
# staging and production NEVER expose links regardless of this value.
# EXPOSE_DEV_MAGIC_LINKS=1
# Comma-separated emails allowed to see the magic link on screen on the STAGING
# tier (useful while email delivery is being set up). Ignored in production.
# MAGIC_LINK_DEBUG_EMAILS=alex@example.com
